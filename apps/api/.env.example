DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kidrehab?schema=public"
PORT=4000
# Comma separated list of allowed browser origins (only needed if the web app calls the API cross-origin)
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS so the refresh-token cookie is marked Secure
COOKIE_SECURE=false
